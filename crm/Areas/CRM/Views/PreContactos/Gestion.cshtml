<script src="@Url.VersionedContent("~/js/frameworks/angularSummernote/angular-summernote.min.js")"></script>
<script src="@Url.VersionedContent("~/js/frameworks/seguimientos/seguimientos.angular.js")"></script>
<script src="@Url.VersionedContent("~/js/Areas/CRM/PreContactos/ControllerGestion.js")"></script>
<style>    
    .border-1 {
        border-right: 3px solid #0091ae;
    }
    .border-2 {
        border-right: 3px solid #009688;
    }
    .border-3 {
        border-right: 3px solid #FF9800;
    }
    .input-numero::-webkit-outer-spin-button,
    .input-numero::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>
<div ng-init="Init()" ng-controller="ControllerGestion">
    <section class="content" ng-show="Modo == 1">
        <div class="box mb-0">
            <div class="box-header with-border">
                <div class="flex flex-center flex-between flex-wrap gap-8">
                    <div class="pn-filter flex flex-center flex-wrap gap-6">
                        <div class="nav-tabs-custom nav-tabs-wizard mr-5">
                            <ul class="nav nav-pills-icon nav-wizard ml-0 mt-0">
                                <li ng-click="ModoVistaProcesos('tabla')"><a style="padding-right: 2px" data-target="#tablaPreContactos" title="Vista de contactos en tabla" data-toggle="tab" class="active"><i class="fal fa-table mr-0"></i></a></li>
                                <li ng-click="ModoVistaProcesos('pieLine')" ng-if="Search.OrigenPreContactoID != null"><a data-target="#lineaPreContactos" title="Vista de contactos en columnas" data-toggle="tab" style="padding-right: 2px; padding-left: 2px"><i class="fal fa-line-columns mr-0"></i></a></li>
                                <li ng-click="AbrirMiCalendario()"><a data-toggle="tab" title="Mi calendario de actividades" style="padding-left: 2px;"><i class="fal fa-calendar-day mr-0"></i></a></li>
                            </ul>
                        </div>
                        <div class="flex flex-center gap-5">
                            <button class="not-btn" ng-click="AbrirModalFiltrar()" title="Filtrar resultados"><i class="fal fa-filter font-23 blue" style="position: relative; top: 3px;"></i></button>
                            <button class="not-btn btn-filter" ng-if="Filtrado" ng-click="QuitarFiltros()" title="Eliminar todos los filtros"><i class="fal fa-times red"></i></button>
                            <h3 class="box-title box-title-sm">Centro de gestión comercial</h3>
                        </div>
                        <button class="btn btn-sm btn-primary" ng-if="FilterOrigenesPreContactos.length > 0" ng-click="AbrirModalAgregar()" style=" height: 23px; padding: 0 5px;">Nuevo <i class="fal fa-plus"></i></button>
                    </div>
                    <div class="pn-options pt-0 flex flex-wrap flex-center gap-6">
                        <div class="mat-paginator-range-actions font-18" ng-if="(PreContactos[0].TotalRows != undefined && PreContactos[0].TotalRows > Search.Rows) && ModoProcesos == 'tabla'">
                            <div class="mat-paginator-range-label" style="white-space: nowrap"> {{ ((Search.Page - 1) * Search.Rows) + 1 }} – {{ (Search.Page * Search.Rows) < PreContactos[0].TotalRows ? (Search.Page * Search.Rows) : PreContactos[0].TotalRows }} de {{ PreContactos[0].TotalRows }} </div>
                            <button mat-icon-button="" type="button" class="mat-focus-indicator mat-tooltip-trigger mat-paginator-navigation-previous mat-icon-button mat-button-base" ng-click="Anterior()" title="Anterior (alt + a)" data-toggle="tooltip" data-placement="left">
                                <span class="mat-button-wrapper">
                                    <svg viewBox="6 5 12 14" focusable="true" class="mat-paginator-icon">
                                        <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path>
                                    </svg>
                                </span>
                            </button>
                            <button mat-icon-button="" type="button" class="mat-focus-indicator mat-tooltip-trigger mat-paginator-navigation-next mat-icon-button mat-button-base" ng-click="Siguiente()" title="Siguiente (alt + s)" data-toggle="tooltip" data-placement="left">
                                <span class="mat-button-wrapper">
                                    <svg viewBox="6 5 12 14" focusable="true" class="mat-paginator-icon">
                                        <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"></path>
                                    </svg>
                                </span>
                            </button>
                        </div>
                        <div class="flex flex-center flex-wrap gap-5">
                            <div class="flex flex-center" style="gap: 5px" ng-if="FilterOrigenesPreContactos.length > 2">
                                <label class="control-label control-label-sm mb-0">Tipos: </label>
                                <select class="form-control input-xs" style="min-width: 90px" ng-model="Search.OrigenPreContactoID" ng-options="item.OrigenPreContactoID as item.Nombre for item in FilterOrigenesPreContactos" ng-change="CambiarOrigenPreContacto()"></select>
                            </div>
                            <button class="not-btn flex flex-center filter-header" md-display="false" ng-if="ModoProcesos == 'tabla'" ng-click="MostrarFiltros()" title="Mostrar panel de filtros (ctrl + b)" data-toggle="tooltip" data-placement="left"><i class="fas fa-filter font-18" ng-style="{ 'color' : IsFiltros ? '#2a6496' : '#aaa' }"></i></button>
                            <button class="not-btn flex flex-center" title="Consultar (alt + r)" ng-click="Consultar();LineaTiempoConsultar()"><i class="fad fa-sync blue font-23"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="box-body">
                <div class="nav-tabs-custom nav-tabs-wizard">
                    <div class="tab-content pt-0">
                        <div id="tablaPreContactos" class="tab-pane active">
                            <div ng-include="ViewsTableCRM"></div>
                        </div>
                        <div id="lineaPreContactos" class="tab-pane">
                            <div class="pie-line" data-ng-model="PreContactosLineaTiempo" id="ContainerLineaTiempo" style="margin: 0 auto;">
                                <div class="pie-line-content">
                                    <div class="pie-line-column" ng-repeat="Linea in PreContactosLineaTiempo" on-finish-render="FinishRenderLineaTiempo()" data-columnindex="{{$index}}" id="column{{$index}}">
                                        <div>
                                            <div class="pie-line-header">
                                                <span>
                                                    {{ Linea.Nombre }}
                                                    <button class="not-btn pull-right" ng-click="Linea.IsFiltros = (Linea.IsFiltros ? false : true)" title="Abrir filtros">
                                                        <i class="fas fa-filter" style="font-size: 18px; position: relative; top: 2px" ng-style="{ 'color': (Linea.IsFiltros ? 'gray' : '') }"></i>
                                                    </button>
                                                </span>
                                                <div class="has-feedback" style="margin: 0 5px 5px 5px" ng-show="Linea.IsFiltros">
                                                    <input type="text" class="form-control input-xs" ng-model="Linea.FullSearch" placeholder="Buscar" maxlength="30" required ng-change="ChangeFullSearch(Linea)" />
                                                    <span class="form-control-feedback" style="padding: 5px 3px"><i class="fas fa-search" style="position: relative; top: -4px;"></i></span>
                                                </div>
                                            </div>
                                            <div class="pie-line-column-content" index="{{ Linea.ProcesoLineaTiempoID }}">
                                                <ul class="pie-line-body" as-sortable="LineaTiempoSortOptions" data-ng-model="Linea.Procesos" ng-style="{ 'height': (Linea.IsFiltros ? 'calc(100vh - 289px)' : 'calc(100vh - 260px)'), 'max-height': (Linea.IsFiltros ? 'calc(100vh - 289px)' : 'calc(100vh - 260px)') }">
                                                    <li ng-repeat="item in Linea.Procesos" class="card-pie-line" context-menu="Menu" as-sortable-item>
                                                        <div as-sortable-item-handle>
                                                            <div>
                                                                <div ng-if="item.Color" class="color-pie-line" ng-style="{ 'border-color' : item.Color }"></div>
                                                                <div class="flex flex-center gap-5" title="Contacto {{ item.NombreCompleto }}">
                                                                    <div style="order: 2">
                                                                        <button class="not-btn pie-line-calendar ml-5" style="width: 19px" ng-click="VisualizarActividadesSeguimientos(item)" title="Seguimientos"><i class="fal fa-comment-alt font-17 blue"></i><span ng-if="item.CountSeguimientos > 0" class="comment-number" style="top: -4px; position: relative;" title="Total de seguimientos {{ item.CountSeguimientos }}">{{ item.CountSeguimientos < 10 ? item.CountSeguimientos : '+' }}</span></button>
                                                                        <button class="not-btn pie-line-calendar relative-top-3" style="width: 19px" ng-click="VisualizarActividadesSeguimientos(item)" title="Actividades"><i ng-class="item.EstadoGeneral == 'V' ? 'fal green' : (item.EstadoGeneral == 'A' ? 'fad yellow' : 'fad red')" class="fa-calendar font-18"></i><span class="number-calendar" ng-class="item.EstadoGeneral == 'V' ? '' : (item.EstadoGeneral == 'A' ? '' : 'font-white')" style=" position: relative; top: 0px" ng-if="item.CountActividades > 0" title="Total actividades {{ item.CountActividades }}">{{ item.CountActividades < 10 ? item.CountActividades : '+' }}</span></button>
                                                                        <button class="not-btn pie-line-calendar relative-top-3" ng-if="Usuario.EdicionLineaTiempo == true" ng-click="CambiarAutomaticaLineaTiempo(item)" style="width: 19px;" title="{{ item.LineaTiempoAutomatica == false ? 'Bloquear proceso' : 'Desbloquear proceso' }}"><i class="fal font-17" ng-class="item.LineaTiempoAutomatica == false ? 'fa-external-link green' : 'fa-external-link-square red'"></i></button>
                                                                    </div>
                                                                    <label class="control-label contacto-pie"><a href="#" ng-click="AbrirCentroGestion(item)">{{ item.NombreCompleto }}</a></label><br />
                                                                </div>
                                                                <div class="flex-center" title="Valor">
                                                                    <label class="control-label font-15 mr-6" ng-if="item.ValorNegocio"><i class="fad fa-dollar-sign green"></i> </label><span ng-if="item.ValorNegocio">{{ item.ValorNegocio | currency : '' : '' }}</span><br ng-if="item.ValorNegocio" />
                                                                </div>
                                                                <div class="flex-center" title="Fecha de registro">
                                                                    <label class="control-label font-15 mr-6"><i class="fal fa-calendar-plus orange"></i> </label><span class="font-8 blue">Registro: </span><span>{{ item.Fecha | date : 'dd/MM/yyyy hh:mm a' }}</span>
                                                                </div>
                                                                <div class="flex-center" title="Fecha de cierre" ng-if="item.FechaCierre">
                                                                    <label class="control-label font-15 mr-6"><i class="fal fa-calendar-check green"></i> </label><span class="font-8 blue">Cierre: </span><span>{{ item.FechaCierre | date : 'dd/MM/yyyy hh:mm a' }}</span>
                                                                </div>
                                                                <div class="flex-center" title="Fecha de cambio" ng-if="item.FechaCambioLineaTiempo">
                                                                    <label class="control-label font-15 mr-6"><i class="fal fa-calendar-edit red"></i> </label><span class="font-8 blue">Cambio: </span><span>{{ item.FechaCambioLineaTiempo | date : 'dd/MM/yyyy hh:mm a' }}</span>
                                                                </div>
                                                                <div class="flex-center" title="Celular {{ item.Celular | tel }}">
                                                                    <label class="control-label font-12 mr-6" ng-if="item.Celular"><i class="fal fa-mobile blue"></i> </label><span ng-if="item.Celular">{{ item.Celular | tel }}</span><br ng-if="item.Celular" />
                                                                </div>
                                                                <div class="flex-center" title="Email {{ item.Email }}">
                                                                    <label class="control-label font-12 mr-6" ng-if="item.Email"><i class="fal fa-envelope blue"></i> </label><span ng-if="item.Email" style=" text-overflow: ellipsis; overflow: hidden">{{ item.Email.replaceAll(';', ', ') }}</span><br ng-if="item.Email" />
                                                                </div>
                                                                <div class="flex-center" title="Asesor comercial" ng-if="Search.AsesorID == null">
                                                                    <label class="control-label font-12 mr-6" ng-if="item.AsesorNombreCompleto"><i class="fal fa-user-cog blue"></i> </label><span ng-if="item.AsesorNombreCompleto">{{ item.AsesorNombreCompleto }}</span><br ng-if="item.AsesorNombreCompleto" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </li>
                                                </ul>
                                            </div>
                                            <div class="pie-line-footer">
                                                <div><span class="font-12" style="font-weight: bold">Total: </span><span class="pull-right" style="font-weight: normal;">{{ Linea.TotalProcesos | currency : '' : '' }}</span></div>
                                                <div><span class="font-12" style="font-weight: bold">Valor: </span><span class="pull-right" style="font-weight: normal;">{{ Linea.TotalValorNegocio | currency : '' : '' }}</span></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="alert alert-danger text-center" role="alert" ng-if="PreContactosLineaTiempo.length == 0" style="margin-bottom: 0px;">
                                        <i class="fal fa-exclamation-triangle font-22" style="margin-right: 5px;"></i> No hay configurado una linea de tiempo para los contactos.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="content flex flex-column gap-7 max-width-900" ng-show="Modo == 2">
        <div class="box-sedi-2">
            <div class="content-flex flex-between flex-wrap gap-7" style="padding: 8px 0">
                <div class="flex flex-center gap-7">
                    <button class="not-btn" ng-click="AtrasModo();" title="Volver a los contactos"><i class="iconify icon-action-undo font-23" style="color: #6c757d !important;"></i></button>
                    <h3 class="box-title font-18">
                        <span ng-bind="Titulo"></span>
                    </h3>
                </div>
                <div class="flex flex-center flex-wrap gap-5 pn-options">
                    <div class="flex flex-center gap-5" ng-if="OrigenesPreContactos.length > 1">
                        <label class="control-label control-label-sm mr-4 mb-0">Tipo de contacto: </label>
                        <select class="form-control input-xs mr-4" style="width: 120px; padding: 0 1px;" ng-options="item.OrigenPreContactoID as item.Nombre for item in OrigenesPreContactos" ng-change="ConsultarCombosOrigenes()" ng-model="PreContacto.OrigenPreContactoID"></select>
                    </div>
                    <button class="not-btn" ng-click="AtrasModo();" title="Volver a los contactos"><i class="fad fa-times" style="color: #6c757d !important; font-size: 27px;"></i></button>
                </div>
            </div>
        </div>
        <div>
            <span class="style-title-sedi">Información general</span>
            <div class="box-sedi-2 border-1">
                <div class="content-block">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3">
                            <label class="control-label control-label-sm mb-0">Nombres</label><strong class="red">*</strong>
                            <div class="form-group has-feedback mb-3">
                                <input type="text" class="form-control input-sm" placeholder="Nombres" ng-model="PreContacto.Nombres" ng-keydown="SearchInputPreContactosExistentes()" maxlength="250" required ng-upper-clean />
                                <span class="glyphicon glyphicon-user form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3">
                            <label class="control-label control-label-sm mb-0">Apellidos</label><strong class="red">*</strong>
                            <div class="form-group has-feedback mb-3">
                                <input type="text" class="form-control input-sm" placeholder="Apellidos" ng-model="PreContacto.Apellidos" ng-keydown="SearchInputPreContactosExistentes()" maxlength="250" required ng-upper-clean />
                                <span class="glyphicon glyphicon-user form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-2">
                            <label class="control-label control-label-sm mb-0">Celular</label><strong class="red">*</strong>
                            <div class="form-group has-feedback mb-3">
                                <input id="txtCelular" type="text" class="form-control input-sm input-numero" placeholder="Celular" ng-model="PreContacto.Celular" ng-keydown="SearchInputPreContactosExistentes()" required maxlength="20" />
                                <span class="glyphicon glyphicon-phone form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-4">
                            <label class="control-label control-label-sm mb-0">Email</label>
                            <div class="form-group has-feedback mb-3">
                                <input type="text" class="form-control input-sm" placeholder="Correo" ng-model="PreContacto.Email" ng-keydown="SearchInputPreContactosExistentes()" maxlength="200" required />
                                <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3" ng-if="PreContacto.OrigenPreContactoID == 7">
                            <label class="control-label control-label-sm mb-0">Ciudad</label>
                            <div class="form-group mb-3">
                                <div custom-select="item.CiudadID as item.Nombre for item in searchCiudades($searchTerm)" custom-select-options="ddlSearchCiudades" class="custom-select-sm" ng-model="PreContacto.CiudadID"></div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-6" ng-if="PreContacto.OrigenPreContactoID == 7">
                            <label class="control-label control-label-sm mb-0">Dirección</label>
                            <div class="form-group mb-3">
                                <button class="btn btn-sm btn-success btn-address" ng-click="AbrirModalDireccion();" style="width: 100%; margin-bottom: 0px;"><i class="fad fa-location"></i>&nbsp;{{ PreContacto.Direccion == '' || PreContacto.Direccion == null ? 'Seleccionar' : PreContacto.Direccion }}</button>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3">
                            <label class="control-label control-label-sm mb-0">¿Como se contactaron?</label><strong class="red">*</strong>
                            <div class="form-group mb-3">
                                <div custom-select="item.FormaContactoID as item.Nombre for item in searchFormasFormasContactos($searchTerm)" class="custom-select-sm" ng-model="PreContacto.FormaContactoID" ng-display="PreContacto.FormaContactoNombre"></div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3">
                            <label class="control-label control-label-sm mb-0">¿Como nos conocieron?</label><strong class="red">*</strong>
                            <div class="form-group mb-3">
