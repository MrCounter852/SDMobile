<script src="@Url.VersionedContent("~/js/frameworks/angularCalendar/ui-bootstrap-tpls-2.5.0.min.js")"></script>
<script src="@Url.VersionedContent("~/js/frameworks/angularCalendar/angular-bootstrap-calendar-tpls.min.js")"></script>
