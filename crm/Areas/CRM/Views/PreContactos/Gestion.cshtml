                        <div class="demo-card-subtitle">Nro. inmueble por que llego: </div> {{ PreContacto.InmuebleConsecutivo }}
                    </div>
                    <div class="demo-card-subhead" ng-if="PreContacto.ProcesosServiciosIniciales.length > 0">
                        <div class="demo-card-subtitle">Servicios solicitados: </div>
                        <span ng-repeat="item in PreContacto.ProcesosServiciosIniciales">{{ item.Nombre }} - </span>
                    </div>
                    <div class="demo-card-supporting-text" ng-if="PreContacto.Observaciones">
                        <div class="demo-card-subtitle">Observaciones: </div>
                        <span ng-bind-html="PreContacto.Observaciones"></span>
                    </div>
                </div>
                <div class="form-group">
                    <div class="demo-card-subhead" ng-if="PreContacto.CausalInviabilidadNombre">
                        <div class="demo-card-subtitle red">Causa inviable: </div> {{ PreContacto.CausalInviabilidadNombre }}
                    </div>
                    <div class="demo-card-subhead" ng-if="PreContacto.FechaInviabilidad">
                        <div class="demo-card-subtitle red">Fecha inviable: </div> {{ PreContacto.FechaInviabilidad | date : 'dd-MM-yyyy hh:mm a' }}
                    </div>
                    <div class="demo-card-supporting-text" ng-if="PreContacto.ObservacionesInviabilidad">
                        <div class="demo-card-subtitle red">Observaciones: </div>
                        <span ng-bind-html="PreContacto.ObservacionesInviabilidad"></span>
                    </div>
                </div>
            </div>
            <div class="content-opciones-footer abs-b-0">
                <button class="btn btn-sm btn-primary mb-5 w50p" ng-click="AbrirModalEditar(PreContacto, 3)">Editar <i class="fal fa-user-edit"></i></button>
                <button class="btn btn-sm btn-success mb-5 w50p" ng-if="PreContacto.EstadoProcesoID == 7" ng-click="ViabilizarProceso(PreContacto, null)">Viable <i class="fal fa-user-crown"></i></button>
                <button class="btn btn-sm btn-danger mb-5 w50p" ng-if="PreContacto.EstadoProcesoID != 7" ng-click="AbrirModalInviabilizar(PreContacto, null)">Inviabilizar <i class="fal fa-user-slash"></i></button>
                <button class="btn btn-sm btn-success mb-5 w100p" ng-click="VisualizarActividadesSeguimientos(PreContacto, null, null, true)"><i class="fal fa-calendar"></i> ({{ PreContacto.CountActividades }}) Actividades y ({{ PreContacto.CountSeguimientos }}) Seguimientos <i class="fal fa-comment-alt"></i></button>
                <button class="btn btn-sm btn-primary mb-5 w50p" ng-click="AbrirModalInventario(PreContacto)">Inventario <i class="fal fa-box-open"></i></button>
            </div>
        </div>
    </div>
    <div ng-include="ViewsInventario"></div>
    <file-viewer ng-viewer="viewer"></file-viewer>
    <address ng-address="address"></address>
    <div id="modalActividad" class="modal fade" role="dialog" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" data-target="#modalCalendario"><i class="fal fa-times"></i></button>
                    <h4 class="modal-title modal-title-sm">
                        <i class="fal fa-calendar-plus"></i>&nbsp;&nbsp;Actividad de calendario
                    </h4>
                </div>
                <div class="modal-body pt-0">
                    <div class="flex-row" ng-if="Actividad.HabilitarFinalizar == false">
                        <div class="flex-170">
                            <label class="control-label control-label-sm mb-0">Tipo Actividad</label><strong class="red">*</strong>
                            <div class="form-group mb-3">
                                <select class="form-control input-sm" ng-options="item.TipoCalendarioActividadID as item.Nombre for item in TiposActividades" ng-model="Actividad.TipoCalendarioActividadID" ng-change="ChangeTipoActividad()"></select>
                            </div>
                        </div>
                        <div class="flex-140">
                            <label class="control-label control-label-sm mb-0">Fecha de inicio</label><strong class="red">*</strong>
                            <div class="form-group has-feedback mb-3">
                                <date-time-picker class="form-control input-sm date-picker" required ng-model="Actividad.FechaInicio" placeholder="DD/MM/YYYY HH:mm" format="DD/MM/YYYY HH:mm" ng-change="ChangeFechaInicio()"></date-time-picker>
                                <span class="glyphicon glyphicon-calendar form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-140">
                            <label class="control-label control-label-sm mb-0">Fecha de vencimiento</label><strong class="red">*</strong>
                            <div class="form-group has-feedback mb-3">
                                <date-time-picker class="form-control input-sm date-picker" required ng-model="Actividad.FechaVencimiento" placeholder="DD/MM/YYYY HH:mm" format="DD/MM/YYYY HH:mm"></date-time-picker>
                                <span class="glyphicon glyphicon-calendar form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-600">
                            <label class="control-label control-label-sm mb-0">Actividad</label>
                            <div class="form-group has-feedback mb-3">
                                <input type="text" class="form-control input-sm" required placeholder="{{ Actividad.TipoCalendarioActividadNombre }}" ng-model="Actividad.Asunto" maxlength="200" aria-label="..." />
                                <span class="glyphicon glyphicon-globe form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-600">
                            <label class="control-label control-label-sm mb-0">Responsable actividad</label><strong class="red">*</strong>
                            <div class="form-group mb-3">
                                <div custom-select="item.UsuarioID as item.NombreCompleto for item in searchAsesoresUsuarios($searchTerm)" class="custom-select-sm" ng-model="Actividad.UsuarioID"></div>
                            </div>
                        </div>
                        <div class="flex-600" ng-if="Search.OrigenPreContactoID == 2 || Search.OrigenPreContactoID == 4 || Search.OrigenPreContactoID == 5">
                            <label class="control-label control-label-sm mb-0">Inmueble que se le asocia la actividad</label>
                            <div class="form-group">
                                <div class="custom-select-sm" custom-select="item.InmuebleID as item.Nombre for item in searchInmuebles($searchTerm)" ng-model="Actividad.InmuebleID"></div>
                            </div>
                        </div>
                        <div class="flex-130" ng-if="Search.OrigenPreContactoID == 1 || Search.OrigenPreContactoID == 6 || Actividad.VisitanteDocumento != null">
                            <label class="control-label control-label-sm mb-0">Documento del visitante</label>
                            <div class="form-group has-feedback mb-3">
                                <input class="form-control input-sm" type="text" required ng-model="Actividad.VisitanteDocumento" placeholder="Cedula o NIT" maxlength="20" />
                                <span class="glyphicon glyphicon-user form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-300" ng-if="Search.OrigenPreContactoID == 1 || Search.OrigenPreContactoID == 6 || Actividad.VisitanteNombreCompleto != null">
                            <label class="control-label control-label-sm mb-0">Visitante</label>
                            <div class="form-group has-feedback mb-3">
                                <input class="form-control input-sm" type="text" required ng-model="Actividad.VisitanteNombreCompleto" placeholder="Nombre completo del que visita el complejo" maxlength="500" />
                                <span class="glyphicon glyphicon-user form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-200" ng-if="Search.OrigenPreContactoID == 1 || Search.OrigenPreContactoID == 6 || Actividad.ComplejoID != null">
                            <label class="control-label control-label-sm mb-0">Complejo que se le asocia la actividad</label>
                            <div class="form-group">
                                <select class="form-control input-sm" ng-options="item.ComplejoID as item.Nombre for item in Complejos" ng-model="Actividad.ComplejoID"></select>
                            </div>
                        </div>
                        <div class="flex-300">
                            <label class="control-label control-label-sm mb-0">Link de reuniones</label>
                            <div class="form-group has-feedback mb-3">
                                <input class="form-control input-sm" type="text" required ng-model="Actividad.Link" placeholder="Link de zoom o meet u otro." maxlength="500" />
                                <span class="glyphicon glyphicon-globe form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-600">
                            <label class="control-label control-label-sm mb-0">Emails invitados</label>
                            <span class="aviso-email font-10">"Para ingresar varios emails separarlo por <strong class="font-14">;</strong> sin espacios."</span>
                            <div class="form-group has-feedback mb-3">
                                <email-box class="form-control input-sm" ng-model="Actividad.Email" required maxlength="1000" placeholder="Agregar invitados"></email-box>
                                <span class="icon glyphicon glyphicon-user form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-600" ng-if="Actividad.Entregable == false;">
                            <label class="control-label control-label-sm mb-0">Dirección actividad</label>
                            <div class="form-group has-feedback mb-3">
                                <input class="form-control input-sm" type="text" required ng-model="Actividad.Direccion" placeholder="Dirección" maxlength="50" />
                                <span class="glyphicon glyphicon-home form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-150" ng-if="Actividad.Entregable == false;">
                            <label class="control-label control-label-sm mb-0">Teléfono</label>
                            <div class="form-group has-feedback mb-3">
                                <input class="form-control input-sm date-picker" type="text" required ng-model="Actividad.Telefono" placeholder="Telefono" maxlength="50" />
                                <span class="glyphicon glyphicon-phone-alt form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-150" ng-if="Actividad.Entregable == false;">
                            <label class="control-label control-label-sm mb-0">Celular</label>
                            <div class="form-group has-feedback mb-3">
                                <input class="form-control input-sm date-picker" required type="text" ng-model="Actividad.Celular" placeholder="Celular" maxlength="50" />
                                <span class="glyphicon glyphicon-phone form-control-feedback"></span>
                            </div>
                        </div>
                        <div class="flex-600">
                            <label class="control-label control-label-sm mb-0">Descripción de la actividad</label>
                            <div class="form-group has-feedback mb-3">
                                <textarea class="form-control input-sm" required ng-model="Actividad.Descripcion" rows="2" maxlength="2000"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="flex-wrap-start" style="gap: 3px 5px" ng-if="Actividad.HabilitarFinalizar == true">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 text-center">
                            <label style="border-bottom: 2px solid #ddd; width: 100%;"><span class="title-mb">Actividad:</span>{{ Actividad.Asunto }}</label>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-6 col-lg-6 text-center">
                            <span class="title-mb">Inicio:</span><div class="mb-activies">{{ Actividad.FechaInicio | date: 'dd/MM/yyyy hh:mm a' }}</div>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-6 col-lg-6 text-center">
                            <span class="title-mb">Fin:</span><div class="mb-activies red">{{ Actividad.FechaVencimiento | date: 'dd/MM/yyyy hh:mm a' }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.UsuarioNombreCompleto != null">
                            <span class="title-mb">Responsable:</span><div class="mb-activies">{{ Actividad.UsuarioNombreCompleto }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.Email != null">
                            <span class="title-mb">Email invitados:</span><div class="mb-activies"><a style="display: inline;color: #555" href="#" ng-repeat="email in Actividad.Email.split(';')" ng-click="AbrirEmail(email)">{{ email }},&nbsp;</a></div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6" ng-if="Actividad.TiposCalendariosActividadesEntregable == false && Actividad.Direccion != null">
                            <span class="title-mb">Direccion:</span><div class="mb-activies">{{ Actividad.Direccion }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-3 col-lg-3" ng-if="Actividad.TiposCalendariosActividadesEntregable == false && Actividad.Telefono != null">
                            <span class="title-mb">Telefono:</span><div class="mb-activies">{{ Actividad.Telefono }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-3 col-lg-3" ng-if="Actividad.TiposCalendariosActividadesEntregable == false && Actividad.Celular != null">
                            <span class="title-mb">Celular:</span><div class="mb-activies">{{ Actividad.Celular }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.InmuebleDescripcion != null">
                            <span class="title-mb">Inmueble:</span><div class="mb-activies">{{ Actividad.InmuebleDescripcion }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.VisitanteNombreCompleto != null">
                            <span class="title-mb">Visitante:</span><div class="mb-activies">{{ Actividad.VisitanteDocumento }} - {{ Actividad.VisitanteNombreCompleto }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.ComplejoNombre != null">
                            <span class="title-mb">Complejo:</span><div class="mb-activies">{{ Actividad.ComplejoNombre }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.Link != null">
                            <span class="title-mb">Link de reuniones:</span><div class="mb-activies"><a href="#" ng-click="AbrirLink(Actividad.Link)">{{ Actividad.Link }}</a></div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.Descripcion != null">
                            <span class="title-mb">Descripción de la actividad:</span><div class="mb-activies" style="font-size: 0.78rem;">{{ Actividad.Descripcion }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.UsuarioCierreNombreCompleto != null">
                            <span class="title-mb">Usuario cierre:</span><div class="mb-activies">{{ Actividad.UsuarioCierreNombreCompleto }}</div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.Completada == false">
                            <label class="control-label control-label-sm mb-0">Observaciones de finalización</label><strong class="red">*</strong>
                            <textarea class="form-control input-sm mb-5" rows="3" ng-model="Actividad.ObservacionesCierre" maxlength="1000" required></textarea>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.Completada == false && Actividad.CantidadActividadesCierres > 0">
                            <div class="flex flex-center mb-5">
                                <label class="control-label control-label-sm mb-0" style="min-width:80px">Tipo de cierre<strong class="red">*</strong></label>
                                <div class="custom-select-xs" custom-select="item.CalendarioActividadCierreDetalleID as item.Nombre for item in searchCalendariosActividadesCierresDetalles($searchTerm)" ng-model="Actividad.CalendarioActividadCierreDetalleID" custom-select-options="ddlSearchCalendariosActividadesCierresDetalles"></div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" ng-if="Actividad.Completada == true">
                            <div class="alert alert-success mb-alert">
                                <span class="title-mb">Resultado de la actividad:</span><span class="font-12" title="Fecha de cierre" data-placement="top" data-toggle="tooltip">{{ Actividad.FechaCierre | date: 'dd/MM/yyyy hh:mm a' }}</span><br />
                                <div class="mb-activies mb-5" style="font-size: 0.78rem;">{{ Actividad.ObservacionesCierre }}</div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 flex-row">
                            <div class="flex-170 text-center" style="border-right: 2px solid #ddd" title="Tipo de actividad" data-placement="top" data-toggle="tooltip">
                                <i class="fad fa-clock blue"></i>&nbsp;
                                <div class="mb-activies mb-0">{{ Actividad.TipoCalendarioActividadNombre }}</div>
                            </div>
                            <div class="flex-170 text-center" style="border-right: 2px solid #ddd" title="Actividad con notificación" data-placement="top" data-toggle="tooltip">
                                <i class="fad" ng-class="Actividad.Notificacion == true ? 'fa-check-circle green' : Actividad.Notificacion == false ? 'fa-times-circle red' : 'fa-times-circle red'"></i>&nbsp;
                                <div class="mb-activies mb-0">Notificación</div>
                            </div>
                            <div class="flex-170 text-center" title="Estado de la actividad" data-placement="top" data-toggle="tooltip">
                                <i class="fad" ng-class="Actividad.Completada == true ? 'fa-check-circle green' : 'fa-exclamation-triangle yellow'"></i>&nbsp;
                                <div class="mb-activies mb-0">{{ Actividad.Completada ? 'Finalizada' : 'Pendiente' }}</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="btn-group pull-right" ng-if="Actividad.HabilitarFinalizar == false">
                        <button class="btn btn-danger" style="padding: 2px 8px" data-dismiss="modal" data-target="#modalActividad">Cancelar</button>
                        <button class="btn btn-success" style="padding: 2px 8px" ng-click="GuardarActividadIndividual()">Guardar</button>
                    </div>
                    <div class="btn-group pull-right" ng-if="Actividad.HabilitarFinalizar == true && Actividad.Completada == false">
                        <button class="btn btn-danger" style="padding: 2px 8px" data-dismiss="modal" data-target="#modalActividad">Cancelar</button>
                        <button class="btn btn-success" style="padding: 2px 8px" ng-click="FinalizarActividadIndividual()">Finalizar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>